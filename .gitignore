# ==============================================================================
# CM TECHMAP — Git Ignore
# ==============================================================================

# ── Production Secrets (NEVER commit) ─────────────────────────────────────────
.env
.env.production
.env.local
.env.*.local
.env.oci
docker/nginx/ssl/

# ── All-in-one deployment runtime state (machine-local, has live URLs) ───────
# NOTE: .env.single and .state/ are still tracked from earlier commits —
# untrack them with `git rm --cached` when convenient; these rules stop new
# churn from being staged.
deploy/all-in-one/.state/
deploy/all-in-one/.env.single

# ── Terraform state (contains sensitive values) ──────────────────────────────
oci-deploy/terraform/.terraform/
oci-deploy/terraform/terraform.tfstate*
oci-deploy/terraform/terraform.tfvars

# ── Build Artifacts ───────────────────────────────────────────────────────────
cm-techmap-frontend/dist/
cm-techmap-frontend/node_modules/
cm-techmap-backend/__pycache__/
cm-techmap-backend/**/__pycache__/
*.pyc
*.pyo

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ── Docker volumes (local dev) ───────────────────────────────────────────────
postgres_data/
redis_data/
minio_data/

# Terraform local state e credenciais OCI
oci-deploy/terraform/.terraform/
oci-deploy/terraform/*.tfstate*
oci-deploy/terraform/tfplan
oci-deploy/a1-retry.log
oci-deploy/.a1-ip
oci-deploy/.stop-retry

# Instalacao local: segredos e backups
deploy/local/.env.local
deploy/local/backups/

# Pacotes de instalacao gerados
deploy/local/dist/
