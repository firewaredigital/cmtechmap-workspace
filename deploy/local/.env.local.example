# ==============================================================================
# CM TECHMAP — Configuração da instalação LOCAL
# ==============================================================================
# O instalador (install.sh / install.ps1) gera o .env.local a partir deste
# modelo, sorteando segredos fortes. Edite só se souber o que está fazendo.
#
# Este arquivo é EXCLUSIVO do ambiente local. Não afeta a produção na Oracle
# (docker-compose.oci-micro.yml + .env.oci na VM) nem o stack de dev.
# ==============================================================================

# ── Domínio de acesso ───────────────────────────────────────────────────────
# Nome pelo qual o sistema é acessado no navegador. O instalador cria a
# entrada correspondente no arquivo de hosts apontando para 127.0.0.1.
# Evite .dev e .app: são TLDs REAIS com HSTS obrigatório — o navegador
# forçaria HTTPS e a instalação local ficaria inacessível.
CM_DOMAIN=cmtechmap.local

# Porta HTTP no host. 80 dá a URL limpa (http://cmtechmap.local).
# Se 80 estiver ocupada (Apache, IIS, Skype), o instalador oferece outra —
# aí a URL vira http://cmtechmap.local:8090 e CM_PORT_SUFFIX precisa
# acompanhar, pois o Keycloak usa isso para montar o emissor dos tokens.
CM_HTTP_PORT=80
CM_PORT_SUFFIX=

# Endereço de bind. 127.0.0.1 = só esta máquina (padrão, mais seguro).
# 0.0.0.0 = outras máquinas da rede local também acessam.
CM_BIND_ADDRESS=127.0.0.1

# ── Segredos (o instalador gera valores aleatórios) ─────────────────────────
POSTGRES_DB=cm_techmap
POSTGRES_USER=cm_techmap
POSTGRES_PASSWORD=GERAR
KC_POSTGRES_DB=keycloak

MINIO_ROOT_USER=cm_techmap
MINIO_ROOT_PASSWORD=GERAR

APP_SECRET_KEY=GERAR

KEYCLOAK_REALM=cm-techmap
KEYCLOAK_CLIENT_ID=cm-techmap-api
# Precisa bater com o secret do client no realm importado
# (docker/keycloak/cm-techmap-realm.json)
KEYCLOAK_CLIENT_SECRET=cm-techmap-api-dev-secret-2026
KEYCLOAK_ADMIN_USERNAME=cmadmin
KEYCLOAK_ADMIN_PASSWORD=GERAR
KEYCLOAK_TIMEOUT=30
KEYCLOAK_EXTRA_ISSUERS=

# ── Dimensionamento (ajuste conforme a máquina) ─────────────────────────────
API_WORKERS=2
API_LOG_LEVEL=info
CELERY_CONCURRENCY=2
# NodeODM é o serviço mais pesado. Reserve pelo menos 4G; 8G+ para
# ortomosaicos grandes. Deixe folga para o resto do sistema.
NODEODM_MEMORY_LIMIT=8G

# ── IA para narrativas de relatório (opcional) ──────────────────────────────
GROQ_ENABLED=false
GROQ_API_KEY=
